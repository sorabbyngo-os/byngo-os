# Byngo OS fstab
# <device>          <mount>   <type>    <options>              <dump> <pass>
/dev/mmcblk0p1      /boot     vfat      ro,noatime             0      2
/dev/mmcblk0p2      /         ext4      rw,noatime,commit=60   0      1
tmpfs               /tmp      tmpfs     rw,nosuid,size=512M    0      0
tmpfs               /run      tmpfs     rw,nosuid,nodev        0      0
