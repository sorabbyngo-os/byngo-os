[Unit]
Description=Byngox Consumer Agent — intent computing engine
After=chameha-voice.service ollama.service
Requires=ollama.service

[Service]
Type=simple
ExecStart=/opt/sorabbyngo/bin/byngox --profile=consumer --agents=health,context,recommendation
Restart=on-failure
RestartSec=5
User=sorabbyngo
Environment=NATS_URL=nats://localhost:4222
Environment=OLLAMA_URL=http://localhost:11434

[Install]
WantedBy=graphical.target
